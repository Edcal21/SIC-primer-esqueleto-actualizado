# Copie este archivo como .dev.vars y reemplace la contraseña.
# Si contiene caracteres especiales, codifíquelos para URL (por ejemplo, @ = %40).
DATABASE_URL="postgresql://postgres:SU_CONTRASENA@localhost:5432/sic"

# Entorno de ejecución. Use "desarrollo" solo en estaciones locales.
# Si no declara entorno, el sistema se comporta como producción: exige SIC_SESSION_SECRET
# y marca la cookie de sesión como Secure (requiere HTTPS).
SIC_ENTORNO="desarrollo"

# Secreto con el que se firman las cookies de sesión. Obligatorio en producción,
# mínimo 32 caracteres y distinto del valor de desarrollo. Genérelo con:
#   node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
SIC_SESSION_SECRET=""
